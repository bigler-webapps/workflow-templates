[Unit]
Description=Route tailnet traffic bound to the per-job interface
After=tailscaled.service tailscaled-mgmt.service
Wants=tailscaled-mgmt.service
Requires=tailscaled.service
PartOf=tailscaled.service tailscaled-mgmt.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/tailnet-binding-route.sh

[Install]
WantedBy=multi-user.target
