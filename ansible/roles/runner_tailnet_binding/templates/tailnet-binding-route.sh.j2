#!/usr/bin/env bash
# {{ ansible_managed }}
# OpenSSH's `BindInterface` binds the SOURCE ADDRESS of the named interface (it does not
# bind the device), so the per-job tailscale0 node's traffic is recognised by its source
# address, not by an output interface. Two policy rules, both ahead of shared table 52:
#   1. traffic sourced from this host's permanent management address uses its own table;
#   2. traffic sourced from any other tailnet address (the ephemeral per-job node) is
#      routed through a dedicated table whose only route sends the tailnet range out of
#      {{ tailnet_binding_interface }}.
# Unbound traffic (no tailnet source) is untouched and still follows shared table 52.
set -euo pipefail

TUN="{{ tailnet_binding_interface }}"
MGMT_TUN="{{ tailnet_binding_mgmt_interface }}"
CIDR="{{ tailnet_binding_tailnet_cidr }}"
TABLE="{{ tailnet_binding_route_table }}"
MGMT_TABLE="{{ tailnet_binding_mgmt_route_table }}"
MGMT_PRIORITY="{{ tailnet_binding_mgmt_rule_priority }}"
JOB_PRIORITY="{{ tailnet_binding_rule_priority }}"
MODE="${1:-apply}"
STATE_DIR="${TAILNET_BINDING_STATE_DIR:-/run/tailnet-binding}"
WAIT_TRIES="${TAILNET_BINDING_WAIT_TRIES:-30}"
WAIT_SLEEP="${TAILNET_BINDING_WAIT_SLEEP:-2}"
TAILNET_ADDR_RE='^100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.'

# One run at a time: the daemon-bound unit and the reconcile timer share this script. The timer skips a
# busy run; the unit waits for it.
install -d -m 0755 "$STATE_DIR"
exec 9>"$STATE_DIR/route.lock"
if [ "$MODE" = reconcile ]; then
    flock -n 9 || exit 0
else
    flock -w 120 9 || { echo "tailnet-binding-route: another run holds the lock" >&2; exit 1; }
fi

mgmt_address() {
    ip -4 -o addr show dev "$MGMT_TUN" 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | grep -m1 -E "$TAILNET_ADDR_RE" || true
}

# Boot and daemon (re)start: the interfaces and the management address appear a little after the units.
# The timer never waits; it simply tries again on its next tick.
if [ "$MODE" != reconcile ]; then
    for _ in $(seq 1 "$WAIT_TRIES"); do
        if ip link show dev "$TUN" >/dev/null 2>&1 && ip link show dev "$MGMT_TUN" >/dev/null 2>&1 && [ -n "$(mgmt_address)" ]; then
            break
        fi
        sleep "$WAIT_SLEEP"
    done
fi

if ! ip link show dev "$TUN" >/dev/null 2>&1 || ! ip link show dev "$MGMT_TUN" >/dev/null 2>&1; then
    [ "$MODE" = reconcile ] && exit 0
    echo "tailnet-binding-route: required link absent" >&2; exit 1
fi
MGMT_ADDR="$(mgmt_address)"

if [ -z "$MGMT_ADDR" ]; then
    [ "$MODE" = reconcile ] && exit 0
    echo "tailnet-binding-route: management address is empty, refusing to install rules" >&2
    exit 1
fi

ip route replace "$CIDR" dev "$TUN" table "$TABLE"
ip route replace "$CIDR" dev "$MGMT_TUN" table "$MGMT_TABLE"

# Install the current management selector before removing any old priority-5254 rule.
# An equal-priority new rule is considered after the existing selector, keeping the old
# route active until stale selectors are removed.
if ! ip -4 rule show | grep -Fq "from $MGMT_ADDR lookup $MGMT_TABLE"; then
    ip rule add from "$MGMT_ADDR/32" lookup "$MGMT_TABLE" priority "$MGMT_PRIORITY"
fi
while IFS= read -r rule; do
    case "$rule" in
        *"$MGMT_PRIORITY:"*)
            if ! printf '%s\n' "$rule" | grep -Fq "from $MGMT_ADDR lookup $MGMT_TABLE"; then
                selector="${rule#*from }"
                selector="${selector%% *}"
                table="${rule##* lookup }"
                table="${table%% *}"
                ip rule del from "$selector" lookup "$table" priority "$MGMT_PRIORITY"
            fi
            ;;
    esac
done < <(ip -4 rule show)
while ip rule del priority "$JOB_PRIORITY" 2>/dev/null; do :; done
ip rule add from "$CIDR" lookup "$TABLE" priority "$JOB_PRIORITY"

# Reconciliation alone is allowed to request recovery. This script is not part
# of the daemon PartOf unit, so restarting tailscaled cannot restart this unit.
if [ "$MODE" = reconcile ]; then
    job_ip="$(ip -4 -o addr show dev "$TUN" | awk '{print $4}' | cut -d/ -f1 | grep -m1 -E '^100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.' || true)"
    if [ -z "$job_ip" ] && tailscale status --json 2>/dev/null | grep -q '"BackendState"[[:space:]]*:[[:space:]]*"Running"'; then
        now="$(date +%s)"; last="$(cat "$STATE_DIR/last-restart" 2>/dev/null || echo 0)"
        if [ $((now - last)) -ge 600 ]; then
            printf '%s\n' "$now" >"$STATE_DIR/last-restart"
            systemctl restart --no-block tailscaled.service
        fi
    fi
fi
