#!/usr/bin/env bash
# {{ ansible_managed }}
# OpenSSH's `BindInterface` binds the SOURCE ADDRESS of the named interface (it does not
# bind the device), so the per-job tailscale0 node's traffic is recognised by its source
# address, not by an output interface. Two policy rules, both ahead of shared table 52:
#   1. traffic sourced from this host's permanent management address uses its own table;
#   2. traffic sourced from any other tailnet address (the ephemeral per-job node) is
#      routed through a dedicated table whose only route sends the tailnet range out of
#      {{ tailnet_binding_interface }}.
# Unbound traffic (no tailnet source) is untouched and still follows shared table 52.
set -euo pipefail

TUN="{{ tailnet_binding_interface }}"
MGMT_TUN="{{ tailnet_binding_mgmt_interface }}"
CIDR="{{ tailnet_binding_tailnet_cidr }}"
TABLE="{{ tailnet_binding_route_table }}"
MGMT_TABLE="{{ tailnet_binding_mgmt_route_table }}"
MGMT_ADDR="{{ tailnet_binding_mgmt_address }}"
MGMT_PRIORITY="{{ tailnet_binding_mgmt_rule_priority }}"
JOB_PRIORITY="{{ tailnet_binding_rule_priority }}"

if [ -z "$MGMT_ADDR" ]; then
    echo "tailnet-binding-route: management address is empty, refusing to install rules" >&2
    exit 1
fi

for link in "$TUN" "$MGMT_TUN"; do
    ready=0
    for _ in $(seq 1 30); do
        if ip link show dev "$link" >/dev/null 2>&1; then
            ready=1
            break
        fi
        sleep 2
    done
    if [ "$ready" -ne 1 ]; then
        echo "tailnet-binding-route: link $link did not appear after 60s" >&2
        exit 1
    fi
done

ip route replace "$CIDR" dev "$TUN" table "$TABLE"
ip route replace "$CIDR" dev "$MGMT_TUN" table "$MGMT_TABLE"

# Install the current management selector before removing any old priority-5254 rule.
# An equal-priority new rule is considered after the existing selector, keeping the old
# route active until stale selectors are removed.
if ! ip -4 rule show | grep -Fq "from $MGMT_ADDR lookup $MGMT_TABLE"; then
    ip rule add from "$MGMT_ADDR/32" lookup "$MGMT_TABLE" priority "$MGMT_PRIORITY"
fi
while IFS= read -r rule; do
    case "$rule" in
        *"$MGMT_PRIORITY:"*)
            if ! printf '%s\n' "$rule" | grep -Fq "from $MGMT_ADDR lookup $MGMT_TABLE"; then
                selector="${rule#*from }"
                selector="${selector%% *}"
                table="${rule##* lookup }"
                table="${table%% *}"
                ip rule del from "$selector" lookup "$table" priority "$MGMT_PRIORITY"
            fi
            ;;
    esac
done < <(ip -4 rule show)
while ip rule del priority "$JOB_PRIORITY" 2>/dev/null; do :; done
ip rule add from "$CIDR" lookup "$TABLE" priority "$JOB_PRIORITY"
